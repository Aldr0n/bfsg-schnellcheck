{
    "preset": "laravel",
    "rules": {
        "method_argument_space": {
            "on_multiline": "ensure_single_line"
        },
        "phpdoc_line_span": {
            "class": "multi",
            "trait_import": "multi",
            "const": "multi",
            "property": "multi",
            "method": "multi",
            "case": "multi",
            "function": "multi",
            "other": null
        },
        "Pint/laravel_blade": true
    }
}
